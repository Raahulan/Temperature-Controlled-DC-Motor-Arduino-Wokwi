{
  "version": 1,
  "author": "Arduino Wokwi Project",
  "editor": "wokwi",
  "parts": [
    {
      "type": "wokwi-arduino-uno",
      "id": "uno",
      "top": -25,
      "left": -120,
      "attrs": {}
    },
    {
      "type": "wokwi-ntc-temperature-sensor",
      "id": "ntc1",
      "top": 185,
      "left": 335,
      "attrs": {
        "temperature": "24",
        "beta": "3950"
      }
    },
    {
      "type": "wokwi-led",
      "id": "led1",
      "top": -160,
      "left": 75,
      "attrs": {
        "color": "red"
      }
    },
    {
      "type": "wokwi-resistor",
      "id": "r1",
      "top": -100,
      "left": 130,
      "rotate": 90,
      "attrs": {
        "value": "220"
      }
    }
  ],
  "connections": [
    [
      "uno:5V",
      "ntc1:VCC",
      "red",
      []
    ],
    [
      "uno:GND.2",
      "ntc1:GND",
      "black",
      []
    ],
    [
      "uno:A0",
      "ntc1:OUT",
      "gold",
      []
    ],
    [
      "uno:3",
      "r1:2",
      "gold",
      []
    ],
    [
      "r1:1",
      "led1:A",
      "gold",
      []
    ],
    [
      "led1:C",
      "uno:GND.1",
      "black",
      []
    ]
  ],
  "serialMonitor": {
    "display": "always",
    "newline": "lf"
  }
}
